# .gitignore - keep generated artifacts and local-only files out of version
# control. All authored source (app.js, server.js, package.json,
# package-lock.json, jest.config.js, README.md, and tests/) stays tracked.

# Dependencies - installed by `npm install`, reproducible from package-lock.json.
node_modules/

# Test coverage output - generated by Jest (matches jest.config.js coverageDirectory).
coverage/

# Logs - npm and runtime log noise.
*.log
npm-debug.log*

# Environment files - local config that may contain secrets; never commit.
.env
.env.local

# OS / editor cruft.
.DS_Store
